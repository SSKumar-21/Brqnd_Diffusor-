<!DOCTYPE html>
<html>

<head>
<title>Admin Dashboard</title>
<link rel="stylesheet" href="/style.css">

<style>
    /* GLOBAL */

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:"Segoe UI",Arial,sans-serif;
}

body{
background:#f4f6fb;
padding:40px;
}

/* MAIN CONTAINER */

.container{
width:100%;
max-width:1200px;
margin:0 auto;     /* centers the whole dashboard */
}

/* HEADER */

.header{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:30px;
}

.header h1{
font-size:28px;
color:#1f2937;
}

/* LOGOUT BUTTON */

.logout{
background:#ff4d4d;
color:white;
padding:10px 18px;
border-radius:8px;
text-decoration:none;
font-size:14px;
transition:0.2s;
}

.logout:hover{
background:#ff1a1a;
}

/* STATS SECTION */

.stats{
background:white;
padding:25px;
border-radius:12px;
box-shadow:0 6px 15px rgba(0,0,0,0.08);
width:260px;
margin-bottom:30px;
}

.stats h2{
font-size:16px;
color:#666;
}

.stats p{
font-size:32px;
font-weight:bold;
color:#2962ff;
margin-top:6px;
}

/* CARD */

.card{
background:white;
padding:25px;
border-radius:12px;
box-shadow:0 6px 15px rgba(0,0,0,0.08);
width:100%;
}

/* TABLE */

table{
width:100%;
border-collapse:collapse;
}

th{
background:#2962ff;
color:white;
padding:14px;
text-align:left;
font-weight:500;
}

td{
padding:14px;
border-bottom:1px solid #eee;
}

tr:hover{
background:#f7f9ff;
}

/* BUTTONS */

.btn{
padding:7px 14px;
border-radius:7px;
text-decoration:none;
font-size:13px;
margin-right:6px;
}

.activity{
background:#00c853;
color:white;
}

.delete{
background:#ff5252;
color:white;
}

.activity:hover{
background:#00b248;
}

.delete:hover{
background:#e53935;
}
</style>


</head>

<body>

<div class="header">

<h1>Admin Dashboard</h1>

<a href="/logout" class="logout">Logout</a>

</div>


<!-- USER STATS -->

<div class="stats">

<h2>Total Users</h2>

<p><%= Object.keys(users).length %></p>

</div>


<!-- USERS TABLE -->

<div class="card">

<table>

<tr>
<th>Email</th>
<th>Company</th>
<th>Actions</th>
</tr>

<% for(let id in users){ %>

<tr>

<td><%= users[id].email %></td>

<td><%= users[id].company || "N/A" %></td>

<td>

<a href="/userActivity/<%= users[id].email %>" class="btn activity">Activity</a>

<a href="/deleteUser/<%= id %>" class="btn delete">Delete</a>

</td>

</tr>

<% } %>

</table>

</div>

</body>

</html>