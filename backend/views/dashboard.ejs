<!DOCTYPE html>
<html>

<head>

<title>Brand Diffusion Generator</title>

<link rel="stylesheet" href="/style.css">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    body{
font-family:Arial, Helvetica, sans-serif;
background:#f4f7fb;
margin:0;
}

.topbar{
display:flex;
align-items:center;
justify-content:space-between;
background:white;
padding:15px 40px;
box-shadow:0 3px 10px rgba(0,0,0,0.08);
}

.logo{
height:40px;
}

.container{
max-width:1200px;
margin:auto;
padding:40px;
}

/* FORM */

.card{
background:white;
padding:30px;
border-radius:12px;
box-shadow:0 6px 15px rgba(0,0,0,0.08);
margin-bottom:40px;
}

.card h3{
margin-bottom:20px;
}

select{
width:100%;
padding:10px;
margin-bottom:15px;
border-radius:6px;
border:1px solid #ccc;
}

button{
background:#2962ff;
color:white;
border:none;
padding:12px;
width:100%;
font-size:16px;
border-radius:6px;
cursor:pointer;
}

button:hover{
background:#0039cb;
}


/* RESULT CARD */

.result-card{
background:white;
padding:25px;
border-radius:12px;
box-shadow:0 6px 15px rgba(0,0,0,0.08);
margin-bottom:40px;
}

.result-card ul{
list-style:none;
padding:0;
}

.result-card li{
display:flex;
justify-content:space-between;
padding:10px 0;
font-size:18px;
border-bottom:1px solid #eee;
}

.percent{
font-weight:bold;
color:#2962ff;
}

/* CHART SECTION */

.charts{
display:flex;
flex-direction:column;
gap:40px;
}

.chart-box{
background:white;
padding:30px;
border-radius:12px;
box-shadow:0 6px 15px rgba(0,0,0,0.08);
}

.chart-box canvas{
width:100% ;
max-width:200px;
height:350px ;
margin:auto;
display:block;
}
#pieChart{
    width: 80%;
    max-height: 500px;
}
</style>

</head>

<body>

<header class="topbar">

<img src="/logo.jpeg" class="logo">

<h2>Brand Diffusion Generator</h2>

<a href="/logout" class="logout">Logout</a>

</header>


<div class="container">


<!-- FORM -->

<div class="card">

<h3>Business Profile</h3>

<form action="/predict" method="POST">

<label>Your Industry</label>
<select name="industry" required>
<option value="Tech">Tech</option>
<option value="Education">Education</option>
<option value="Fitness">Fitness</option>
<option value="Fashion">Fashion</option>
</select>

<label>Company Size</label>
<select name="company_size" required>
<option value="Small">Small</option>
<option value="Medium">Medium</option>
<option value="Large">Large</option>
</select>

<label>Budget</label>
<select name="budget" required>
<option value="Low">Low</option>
<option value="Medium">Medium</option>
<option value="High">High</option>
</select>

<label>Age Group</label>
<select name="age_group" required>
<option value="18-25">18-25</option>
<option value="18-30">18-30</option>
<option value="25-35">25-35</option>
<option value="25-40">25-40</option>
</select>

<label>Gender</label>
<select name="gender" required>
<option value="Male">Male</option>
<option value="Female">Female</option>
</select>

<label>Interest</label>
<select name="interest" required>
<option value="Technology">Technology</option>
<option value="Fashion">Fashion</option>
<option value="Fitness">Fitness</option>
<option value="Education">Education</option>
</select>

<br><br>

<button type="submit">Generate Brand Diffusion</button>

</form>

</div>


<!-- ERROR DISPLAY -->

<% if(result && result.error){ %>

<div class="result-card">

<h2 style="color:red">Error</h2>

<p><%= result.error %></p>

<% if(result.allowed_values){ %>

<p>Allowed values:</p>

<ul>
<% result.allowed_values.forEach(function(v){ %>
<li><%= v %></li>
<% }) %>
</ul>

<% } %>

</div>

<% } %>


<!-- PREDICTIONS -->

<% if(result && result.predictions){ %>

<div class="result-card">

<h2>Top Platform Recommendations</h2>

<ul>

<% result.predictions.slice(0,3).forEach(function(p){ %>

<li>

<strong><%= p.platform %></strong>

<span class="percent"><%= p.probability %>%</span>

</li>

<% }) %>

</ul>

</div>


<!-- CHARTS -->

<div class="charts">

<h3>Bar Chart Analysis</h3>
<canvas id="barChart"></canvas>

<h3>Line Trend</h3>
<canvas id="lineChart"></canvas>

<h3>Platform Distribution</h3>
<canvas id="pieChart"></canvas>

</div>


<script>

    const predictions = <%- JSON.stringify(result.predictions || []) %>;
    
    const labels = predictions.map(p => p.platform);
    const values = predictions.map(p => p.probability);
    
    /* ZOOM RANGE CALCULATION */
    
    const minValue = Math.min(...values) - 1;
    const maxValue = Math.max(...values) + 0.2;
    
    const chartData = {
    labels: labels,
    datasets:[{
    label:"Prediction Probability %",
    data: values,
    backgroundColor:[
    "#2962ff",
    "#ff5252",
    "#00c853",
    "#ff9800",
    "#ffca28"
    ],
    borderWidth:2
    }]
    };
    
    
    /* BAR CHART */
    
    new Chart(document.getElementById("barChart"),{
    type:"bar",
    data:chartData,
    options:{
    responsive:true,
    scales:{
    y:{
    min:minValue,
    max:maxValue,
    ticks:{
    callback:function(value){
    return value + "%"
    }
    }
    }
    }
    }
    })
    
    
    /* LINE CHART */
    
    new Chart(document.getElementById("lineChart"),{
    type:"line",
    data:chartData,
    options:{
    responsive:true,
    scales:{
    y:{
    min:minValue,
    max:maxValue,
    ticks:{
    callback:function(value){
    return value + "%"
    }
    }
    }
    }
    }
    })
    
    
    /* PIE CHART */
    
    new Chart(document.getElementById("pieChart"),{
    type:"pie",
    data:chartData,
    options:{
    responsive:true,
    plugins:{
    tooltip:{
    callbacks:{
    label:function(context){
    return context.label + " : " + context.raw + "%"
    }
    }
    }
    }
    }
    })
    
    </script>

<% } %>


</div>

</body>

</html>